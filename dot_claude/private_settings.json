{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/simplified-technical-english.sh\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "jq -r '\"model: \" + (.model // \"default\")' ~/.claude/settings.json"
  },
  "enabledPlugins": {
    "stdd-agents@stdd-agents": false,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "caveman@caveman": false,
    "ponytail@ponytail": true,
    "i-have-adhd@i-have-adhd": true,
    "headroom@headroom-marketplace": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    },
    "headroom-marketplace": {
      "source": {
        "source": "github",
        "repo": "headroomlabs-ai/headroom"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "tui": "fullscreen",
  "autoDreamEnabled": false,
  "editorMode": "vim",
  "autoCompactEnabled": true
}
